        "options": {}
      },
      "id": "wh-evo",
      "name": "Webhook Evolution",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "dbced436-cfd1-51cc-a1a7-8fb1fb736973"
    },
    {
      "parameters": {
        "jsCode": "// ── CONFIG ──────────────────────────────────────────────────────\n// Mapeia o TELEFONE do remetente para o usuário do EasyWorkHub.\n// TODO: preencher telefone real da Ana e o token (mesmo do atalho).\nconst USUARIOS = {\n  '5599999999999': {\n    nome: 'Ana Beatriz',\n    token: 'TODO_plane_api_...',\n    projeto: '1a84be32-f826-4a28-a99c-4f17cf36c20e'\n  }\n};\nconst EVO_URL = 'https://evo.fisioterapia.cloud';\nconst EVO_INSTANCIA = 'easyworkhub-captura';\n// ────────────────────────────────────────────────────────────────\n\nconst b = $input.first().json.body || $input.first().json;\nif (b.event !== 'messages.upsert') return []; // ignora outros eventos\nconst data = b.data || {};\nconst key = data.key || {};\nif (key.fromMe) return [];                       // ignora mensagens enviadas por nós\nif ((key.remoteJid || '').endsWith('@g.us')) return []; // ignora grupos\n\nconst telefone = (key.remoteJid || '').split('@')[0];\nconst u = USUARIOS[telefone];\nif (!u) return []; // número não cadastrado: silêncio (não vaza existência do fluxo)\n\nconst msg = data.message || {};\nconst textoDireto = msg.conversation || msg.extendedTextMessage?.text || null;\nconst temAudio = !!msg.audioMessage;\n\nconst hora = new Date().toLocaleTimeString('pt-BR', {\n  timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit'\n});\nreturn [{ json: {\n  telefone, remoteJid: key.remoteJid, messageId: key.id,\n  token: u.token, projeto: u.projeto,\n  texto: textoDireto, temAudio, hora,\n  evoUrl: EVO_URL, evoInstancia: EVO_INSTANCIA\n}}];"
      },
      "id": "cfg-filtrar",
      "name": "Filtrar e identificar usuário",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
