    {
      "parameters": {
        "jsCode": "// Junta o caminho do áudio (transcrição) e o do texto puro num payload único.\nconst base = $('Filtrar e identificar usuário').first().json;\nlet texto, origem;\nif (base.temAudio) {\n  texto = ($json.text || '').trim();\n  origem = `Capturado por voz • ${base.hora}`;\n  if (!texto) texto = '(áudio sem fala reconhecível — ouvir no WhatsApp)';\n} else {\n  texto = (base.texto || '').trim();\n  origem = `Capturado por texto • ${base.hora}`;\n}\nif (!texto) return [];\nreturn [{ json: {\n  ...base,\n  titulo: texto.length > 120 ? texto.slice(0, 117) + '…' : texto,\n  descricao: `<p>${texto}</p><p><em>${origem}</em></p>`\n}}];"
      },
